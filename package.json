{
  "name": "dsh-skill-manager",
  "description": "Sidebar Skills hub for DSH: global skill and MCP enablement plus per-workspace fine-grained controls",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "PLAN.md",
    "README.md",
    "README.zh.md"
  ],
  "license": "MIT",
  "author": "Gyanano",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gyanano/dsh-skill-manager.git"
  },
  "homepage": "https://github.com/Gyanano/dsh-skill-manager#readme",
  "bugs": {
    "url": "https://github.com/Gyanano/dsh-skill-manager/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/selftest.mjs && node scripts/client-harness.mjs && node scripts/popover-harness.mjs && node scripts/import-selftest.mjs"
  },
  "keywords": [],
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.24.2",
    "jsdom": "^24.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3"
  }
}
